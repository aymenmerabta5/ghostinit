{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "../.tsbuildinfo/src.tsbuildinfo",
    "paths": {
      "@/*": ["./*"],
      "@repo/versions": ["../packages/versions/src/index.ts"],
      "@repo/typescript-config/*": ["../tooling/typescript-config/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["../node_modules", "../dist"],
  "references": [
    {
      "path": "../packages/versions"
    }
  ]
}
