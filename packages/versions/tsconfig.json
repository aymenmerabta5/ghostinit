{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tooling/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo/versions.tsbuildinfo"
  },
  "include": ["src/**/*"]
}
