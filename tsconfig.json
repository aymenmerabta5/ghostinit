{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "./.tsbuildinfo/root.tsbuildinfo"
  },
  "include": ["src/**/*", "packages/**/src/**/*", "tooling/**/*"],
  "exclude": ["node_modules", "dist", "tests/fixtures"],
  "references": [
    {
      "path": "./packages/versions"
    },
    {
      "path": "./src"
    }
  ]
}
