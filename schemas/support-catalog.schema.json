{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostinit.dev/schemas/support-catalog.schema.json",
  "title": "GhostInit V2 support catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogVersion",
    "axes",
    "deployBindings",
    "databaseDeployBindings",
    "defaultDenyCapabilityDeployTargets",
    "capabilityDeployBindings",
    "billingProviderClientBindings",
    "capabilities",
    "operationEvidence",
    "compatibilityEvidence"
  ],
  "properties": {
    "$schema": { "const": "https://ghostinit.dev/schemas/support-catalog.schema.json" },
    "schemaVersion": { "const": 2 },
    "catalogVersion": { "const": 2 },
    "axes": { "$ref": "#/$defs/axes" },
    "deployBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/deployBinding" }
    },
    "databaseDeployBindings": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/databaseDeployBinding" }
    },
    "defaultDenyCapabilityDeployTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["vercel", "fly", "docker", "cloudflare", "none"] }
    },
    "capabilityDeployBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityDeployBinding" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "billingProviderClientBindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "operationIds"],
        "properties": {
          "provider": { "enum": ["stripe", "chargily", "paddle", "polar"] },
          "operationIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "billing.checkout.v1",
                "billing.invoices.v1",
                "billing.payment-link.v1",
                "billing.portal.v1",
                "billing.subscriptions.v1"
              ]
            }
          }
        }
      }
    },
    "operationEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationEvidence" }
    },
    "compatibilityEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/compatibilityEvidence" }
    }
  },
  "$defs": {
    "capabilityId": {
      "enum": [
        "transport",
        "auth",
        "billing",
        "messaging",
        "email",
        "storage",
        "cache",
        "analytics",
        "i18n",
        "pdf",
        "eve",
        "notifications",
        "featureFlags",
        "jobs"
      ]
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "appTargets",
        "databases",
        "cacheProviders",
        "deployTargets",
        "executionRuntimes",
        "billingProviders",
        "featureFlagProviders",
        "packageManagers"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["monorepo", "single"] }
        },
        "appTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["nextjs", "tanstack-start", "expo", "electron"] }
        },
        "databases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["postgres", "convex", "none"] }
        },
        "cacheProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["redis", "none"] }
        },
        "deployTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["vercel", "fly", "docker", "cloudflare", "none"] }
        },
        "executionRuntimes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["bun", "node"] }
        },
        "billingProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["stripe", "chargily", "paddle", "polar"] }
        },
        "featureFlagProviders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "posthog" }
        },
        "packageManagers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "const": "bun" },
              "version": { "const": "1.4.0" }
            }
          }
        }
      }
    },
    "deployBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "modes", "executionRuntimes", "deployTargets"],
      "properties": {
        "target": { "enum": ["nextjs", "tanstack-start", "expo", "electron"] },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["monorepo", "single"] }
        },
        "executionRuntimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bun", "node"] }
        },
        "deployTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["vercel", "fly", "docker", "cloudflare", "none"] }
        }
      }
    },
    "capabilityDeployBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "database", "deployTargets"],
      "properties": {
        "capability": { "$ref": "#/$defs/capabilityId" },
        "database": { "enum": ["postgres", "convex", "none"] },
        "deployTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["vercel", "fly", "docker", "cloudflare", "none"] }
        }
      }
    },
    "databaseDeployBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "deployTargets"],
      "properties": {
        "database": { "enum": ["postgres", "convex", "none"] },
        "deployTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["vercel", "fly", "docker", "cloudflare", "none"] }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "requirements",
        "acceptanceOperationIds",
        "clientSurfaceRequired",
        "clientBindings"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "description": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "acceptanceOperationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
          }
        },
        "clientSurfaceRequired": { "type": "boolean" },
        "clientBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nextjs", "tanstack-start", "expo", "electron"],
          "properties": {
            "nextjs": { "$ref": "#/$defs/clientBinding" },
            "tanstack-start": { "$ref": "#/$defs/clientBinding" },
            "expo": { "$ref": "#/$defs/clientBinding" },
            "electron": { "$ref": "#/$defs/clientBinding" }
          }
        }
      }
    },
    "clientBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredOperationIds", "requiredArtifacts"],
      "properties": {
        "status": { "enum": ["supported", "unsupported", "not-required"] },
        "requiredOperationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
          }
        },
        "requiredArtifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["route", "adapter", "manifest", "acceptance"] }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-required" } } },
          "then": {
            "properties": {
              "requiredOperationIds": { "type": "array", "maxItems": 0 },
              "requiredArtifacts": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "requiredOperationIds": { "type": "array", "minItems": 1 },
              "requiredArtifacts": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unsupported" } } },
          "then": {
            "required": ["reason"],
            "properties": { "reason": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "operationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "operationId", "artifacts"],
      "properties": {
        "capability": { "$ref": "#/$defs/capabilityId" },
        "operationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationEvidenceArtifact" }
        }
      }
    },
    "operationEvidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "testName"],
      "properties": {
        "kind": { "const": "bun-test" },
        "path": {
          "type": "string",
          "pattern": "^tests/(?:unit|integration)/.+\\.test\\.[cm]?[jt]sx?$"
        },
        "testName": { "type": "string", "minLength": 1 }
      }
    },
    "compatibilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "status", "note", "requiredEvidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
        },
        "subject": { "enum": ["execution-runtime:bun", "execution-runtime:node"] },
        "status": { "const": "retained-compatibility" },
        "note": { "type": "string", "minLength": 1 },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
          }
        }
      }
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "capability"],
          "properties": {
            "kind": { "const": "capability" },
            "capability": { "$ref": "#/$defs/capabilityId" },
            "when": { "const": "jobs-user-facing-api" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "backend" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "persistence" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subject", "targets"],
          "properties": {
            "kind": { "const": "target-binding" },
            "subject": { "enum": ["any-app", "backend-host"] },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["nextjs", "tanstack-start", "expo", "electron"] }
            }
          }
        }
      ]
    }
  }
}
