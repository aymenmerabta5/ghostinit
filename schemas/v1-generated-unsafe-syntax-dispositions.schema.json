{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostinit.dev/schemas/v1-generated-unsafe-syntax-dispositions.schema.json",
  "title": "GhostInit V1 generated unsafe-syntax disposition policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogEvidence",
    "projectionEvidence",
    "gateEvidence",
    "defaultProjection",
    "zeroGatePhase",
    "rules"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/v1-generated-unsafe-syntax-dispositions.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "catalogEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configKeys",
        "occurrenceRows",
        "uniqueOwnerPathPatterns",
        "uniqueSourceOwners",
        "provenanceRules"
      ],
      "properties": {
        "configKeys": { "$ref": "#/$defs/catalogConfigKeys" },
        "occurrenceRows": { "const": 1011 },
        "uniqueOwnerPathPatterns": { "const": 99 },
        "uniqueSourceOwners": { "const": 60 },
        "provenanceRules": { "const": 101 }
      }
    },
    "projectionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configKeys",
        "occurrenceRows",
        "uniqueOwnerPathPatterns",
        "uniqueSourceOwners",
        "provenanceRules",
        "comparableStripeOnKeys"
      ],
      "properties": {
        "configKeys": { "$ref": "#/$defs/projectionConfigKeys" },
        "occurrenceRows": { "const": 839 },
        "uniqueOwnerPathPatterns": { "const": 94 },
        "uniqueSourceOwners": { "const": 55 },
        "provenanceRules": { "const": 96 },
        "comparableStripeOnKeys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configKeys", "removeInStabilization", "deferredV1"],
          "properties": {
            "configKeys": {
              "type": "array",
              "prefixItems": [
                { "const": "monorepo/nextjs/postgres/capabilities-on" },
                { "const": "single/nextjs/postgres/capabilities-on" }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "removeInStabilization": { "const": 72 },
            "deferredV1": { "const": 85 }
          }
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurations",
        "occurrenceRows",
        "gateOnlyChargilyOccurrences",
        "gateOnlyOwnerPathPatterns"
      ],
      "properties": {
        "configurations": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/nextMonorepoGate" },
            { "$ref": "#/$defs/singleNextGate" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "occurrenceRows": { "const": 172 },
        "gateOnlyChargilyOccurrences": { "const": 15 },
        "gateOnlyOwnerPathPatterns": { "const": 5 }
      }
    },
    "defaultProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configKeys", "removeInStabilization", "deferredV1"],
      "properties": {
        "configKeys": {
          "type": "array",
          "prefixItems": [{ "const": "gate/next-monorepo" }, { "const": "gate/single-next" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "removeInStabilization": { "const": 72 },
        "deferredV1": { "const": 100 }
      }
    },
    "zeroGatePhase": { "const": "V2 Phase 6" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 101,
      "maxItems": 101,
      "uniqueItems": true
    }
  },
  "$defs": {
    "catalogConfigKeys": {
      "type": "array",
      "prefixItems": [
        { "const": "gate/next-monorepo" },
        { "const": "gate/single-next" },
        { "const": "monorepo/nextjs/convex/capabilities-off" },
        { "const": "monorepo/nextjs/convex/capabilities-on" },
        { "const": "monorepo/nextjs/postgres/capabilities-off" },
        { "const": "monorepo/nextjs/postgres/capabilities-on" },
        { "const": "monorepo/tanstack-start/convex/capabilities-off" },
        { "const": "monorepo/tanstack-start/convex/capabilities-on" },
        { "const": "monorepo/tanstack-start/postgres/capabilities-off" },
        { "const": "monorepo/tanstack-start/postgres/capabilities-on" },
        { "const": "single/nextjs/convex/capabilities-off" },
        { "const": "single/nextjs/convex/capabilities-on" },
        { "const": "single/nextjs/postgres/capabilities-off" },
        { "const": "single/nextjs/postgres/capabilities-on" },
        { "const": "single/tanstack-start/convex/capabilities-off" },
        { "const": "single/tanstack-start/convex/capabilities-on" },
        { "const": "single/tanstack-start/postgres/capabilities-off" },
        { "const": "single/tanstack-start/postgres/capabilities-on" }
      ],
      "items": false,
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true
    },
    "projectionConfigKeys": {
      "type": "array",
      "prefixItems": [
        { "const": "monorepo/nextjs/convex/capabilities-off" },
        { "const": "monorepo/nextjs/convex/capabilities-on" },
        { "const": "monorepo/nextjs/postgres/capabilities-off" },
        { "const": "monorepo/nextjs/postgres/capabilities-on" },
        { "const": "monorepo/tanstack-start/convex/capabilities-off" },
        { "const": "monorepo/tanstack-start/convex/capabilities-on" },
        { "const": "monorepo/tanstack-start/postgres/capabilities-off" },
        { "const": "monorepo/tanstack-start/postgres/capabilities-on" },
        { "const": "single/nextjs/convex/capabilities-off" },
        { "const": "single/nextjs/convex/capabilities-on" },
        { "const": "single/nextjs/postgres/capabilities-off" },
        { "const": "single/nextjs/postgres/capabilities-on" },
        { "const": "single/tanstack-start/convex/capabilities-off" },
        { "const": "single/tanstack-start/convex/capabilities-on" },
        { "const": "single/tanstack-start/postgres/capabilities-off" },
        { "const": "single/tanstack-start/postgres/capabilities-on" }
      ],
      "items": false,
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true
    },
    "nextMonorepoGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configKey",
        "mode",
        "framework",
        "database",
        "billing",
        "apps",
        "capabilities",
        "occurrenceRows"
      ],
      "properties": {
        "configKey": { "const": "gate/next-monorepo" },
        "mode": { "const": "monorepo" },
        "framework": { "const": "nextjs" },
        "database": { "const": "postgres" },
        "billing": {
          "type": "array",
          "prefixItems": [{ "const": "stripe" }, { "const": "chargily" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "apps": {
          "type": "array",
          "prefixItems": [{ "const": "web" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "capabilities": { "const": "on" },
        "occurrenceRows": { "const": 101 }
      }
    },
    "singleNextGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configKey",
        "mode",
        "framework",
        "database",
        "billing",
        "apps",
        "capabilities",
        "occurrenceRows"
      ],
      "properties": {
        "configKey": { "const": "gate/single-next" },
        "mode": { "const": "single" },
        "framework": { "const": "nextjs" },
        "database": { "const": "postgres" },
        "billing": {
          "type": "array",
          "prefixItems": [{ "const": "stripe" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "apps": {
          "type": "array",
          "prefixItems": [{ "const": "web" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "capabilities": { "const": "on" },
        "occurrenceRows": { "const": 71 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOwner",
        "emittedPathPattern",
        "applicableConfigKeys",
        "expectedOccurrences",
        "disposition",
        "removalPhase"
      ],
      "properties": {
        "sourceOwner": { "type": "string", "pattern": "^src/templates/" },
        "emittedPathPattern": { "type": "string", "minLength": 3 },
        "applicableConfigKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "expectedOccurrences": { "type": "integer", "minimum": 1 },
        "disposition": { "enum": ["remove-in-stabilization", "deferred-v1"] },
        "removalPhase": { "enum": ["Phase 1A", "V2 Phase 6"] }
      }
    }
  }
}
