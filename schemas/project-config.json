{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GhostInit Project Config",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Project name (lowercase letter followed by lowercase alphanumeric and hyphens)"
    },
    "runtime": {
      "type": "string",
      "enum": ["bun", "node"],
      "default": "bun",
      "description": "Target runtime for the generated project"
    },
    "version": {
      "type": "string",
      "default": "0.1.0",
      "description": "Initial project version"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the project was generated"
    }
  },
  "additionalProperties": false
}
