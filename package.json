{
  "name": "ghostinit",
  "version": "0.1.0",
  "private": false,
  "description": "Production-grade Bun-powered CLI that generates well-structured monorepos with architectural linting (inspired by modular monolith, build-time enforcement via oxc-parser) for Next.js/TanStack Start.",
  "license": "MIT",
  "bin": {
    "ghostinit": "dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "tooling/*"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "schemas/**/*",
    "policy/**/*",
    "evidence/compatibility/**/*",
    "docs/engineering/**/*",
    "patches/@electric-sql%2Fpglite-socket@0.2.10.patch",
    "README.md",
    "VISION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./schemas/*": "./schemas/*",
    "./compatibility/*": "./evidence/compatibility/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run --watch src/cli.ts",
    "typecheck": "bunx --no-install tsc -b && bun run typecheck:scripts",
    "typecheck:scripts": "bunx --no-install tsc -p tsconfig.scripts.json --noEmit",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit",
    "format": "oxfmt --write .",
    "pretest": "bun run build",
    "test": "bun test --timeout 100000 tests/integration tests/unit",
    "test:fixtures": "bun run scripts/test-fixtures.ts",
    "test:e2e-build": "E2E_BUILD=1 bun test --timeout 1800000 tests/integration/e2e-build.test.ts",
    "test:realtime-runtime": "NITRO_WEBSOCKET_RUNTIME=1 bun test --timeout 900000 tests/integration/nitro-websocket-compat-runtime.test.ts",
    "test:convex-codegen": "CONVEX_CODEGEN_RUNTIME=1 bun test --timeout 900000 tests/integration/convex-codegen-runtime.test.ts",
    "test:ci": "bun run check:lock-age && bun run check && bun run typecheck && bun run scripts/sync-turbo-env.ts --check && bun run check:versions && bun run check:capability-evidence && bun audit --audit-level=high && git diff --check && bun run test && bun run test:fixtures && bun run test:convex-codegen && bun run test:generated -- --all && bun run test:realtime-runtime && bun run test:e2e-build",
    "test:generated": "bun run scripts/test-generated.ts",
    "test:workers": "bun run scripts/test-generated.ts --workers",
    "check:capability-evidence": "bun run scripts/check-capability-evidence.ts",
    "check:lock-age": "bun run scripts/check-lock-release-age.ts",
    "check:versions": "bun run scripts/check-versions.ts",
    "release:artifact": "bun run scripts/release-artifact.ts",
    "release": "bun run test:ci && bun run release:artifact"
  },
  "dependencies": {
    "@chargily/chargily-pay": "2.1.0",
    "@clack/prompts": "1.8.1",
    "oxc-parser": "0.152.0",
    "oxfmt": "0.71.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/core": "1.6.33",
    "@better-auth/passkey": "1.6.33",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.10",
    "@orpc/client": "1.15.4",
    "@orpc/contract": "1.15.4",
    "@orpc/server": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@playwright/test": "1.63.0",
    "@react-pdf/renderer": "4.9.0",
    "@types/bun": "1.4.0",
    "@types/node": "24.19.1",
    "@upstash/redis": "1.39.0",
    "ajv": "8.20.0",
    "better-auth": "1.6.33",
    "dejavu-fonts-ttf": "2.37.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "eve": "0.44.4",
    "oxlint": "1.86.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@types/node": "24.19.1",
    "undici": "8.10.2"
  },
  "engines": {
    "bun": "1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@electric-sql/pglite-socket@0.2.10": "patches/@electric-sql%2Fpglite-socket@0.2.10.patch"
  },
  "_comment_private": "Root IS the publishable CLI (bin ghostinit). Keep private false so Bun can publish it to the npm registry. This is intentional, not a monorepo root that is never published."
}
