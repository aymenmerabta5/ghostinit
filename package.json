{
  "name": "ghostinit",
  "version": "0.1.0",
  "description": "Production-grade Bun-powered CLI that generates opinionated modular-monolith Next.js architectures.",
  "license": "MIT",
  "bin": {
    "ghostinit": "dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "files": [
    "dist/cli.js",
    "src/**/*",
    "schemas/project-config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir ./dist --target node --external zod",
    "dev": "bun run --watch src/cli.ts",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit",
    "format": "oxfmt --write .",
    "pretest": "bun run build",
    "test": "bun test tests/integration tests/unit",
    "pretest:fixtures": "cd tests/fixtures/compatibility/drizzle-betterauth-orpc && bun install && cd ../next-tailwind-biome && bun install",
    "test:fixtures": "bun test tests/fixtures",
    "test:ci": "bun run test && bun run test:fixtures",
    "release": "bun run build && npm pack"
  },
  "dependencies": {
    "oxc-parser": "^0.139.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orpc/contract": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/zod": "^1.14.7",
    "@types/bun": "1.2.14",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
